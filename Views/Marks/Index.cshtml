@model IEnumerable<StudentResultManagement.Models.Mark>
@{
    ViewData["Title"] = "Marks";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-journal-text"></i> Marks Management</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Marks</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card card-custom">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle fs-4 d-block mb-2"></i>
                No marks found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Student</th>
                            <th>Subject</th>
                            <th>Internal</th>
                            <th>External</th>
                            <th>Total</th>
                            <th>Grade</th>
                            <th>Result</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr>
                                <td>
                                    <div class="fw-bold">@item.Student?.RegisterNumber</div>
                                    <div class="small text-muted">@item.Student?.Name</div>
                                </td>
                                <td>
                                    <div class="fw-bold">@item.Subject?.SubjectCode</div>
                                    <div class="small text-muted">@item.Subject?.SubjectName</div>
                                </td>
                                <td>@item.InternalMark</td>
                                <td>@item.ExternalMark</td>
                                <td><strong>@item.Total</strong></td>
                                <td><span class="badge bg-secondary">@item.Grade</span></td>
                                <td>
                                    @if(item.ResultStatus == "PASS")
                                    {
                                        <span class="badge bg-success">PASS</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">FAIL</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.MarkId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.MarkId" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
