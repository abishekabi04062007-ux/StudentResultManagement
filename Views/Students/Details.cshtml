@model StudentResultManagement.Models.Student
@{
    ViewData["Title"] = "Student Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-person-badge"></i> Student Details</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Students</a>
</div>

<div class="card card-custom mb-4">
    <div class="card-header bg-white fw-bold">
        <i class="bi bi-info-circle"></i> Personal & Academic Information
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <table class="table table-sm table-borderless">
                    <tr><th style="width: 150px;">Register Number:</th><td class="fw-bold">@Model.RegisterNumber</td></tr>
                    <tr><th>Student Name:</th><td>@Model.Name</td></tr>
                    <tr><th>Date of Birth:</th><td>@Model.DateOfBirth.ToString("dd-MMM-yyyy")</td></tr>
                    <tr><th>Gender:</th><td>@Model.Gender</td></tr>
                    <tr><th>Email:</th><td>@Model.Email</td></tr>
                    <tr><th>Phone:</th><td>@Model.Phone</td></tr>
                    <tr><th>Address:</th><td>@Model.Address</td></tr>
                </table>
            </div>
            <div class="col-md-6">
                <table class="table table-sm table-borderless">
                    <tr><th style="width: 150px;">Department:</th><td class="fw-bold">@Model.Department</td></tr>
                    <tr><th>Year:</th><td>@Model.Year</td></tr>
                    <tr><th>Semester:</th><td>@Model.Semester</td></tr>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="card card-custom">
    <div class="card-header bg-white fw-bold">
        <i class="bi bi-journal-text"></i> Marks & Results
    </div>
    <div class="card-body">
        @if (Model.Marks != null && Model.Marks.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered align-middle text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-start">Subject Code</th>
                            <th class="text-start">Subject Name</th>
                            <th>Internal</th>
                            <th>External</th>
                            <th>Total</th>
                            <th>Grade</th>
                            <th>Result</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mark in Model.Marks)
                        {
                            <tr>
                                <td class="text-start fw-bold">@mark.Subject?.SubjectCode</td>
                                <td class="text-start">@mark.Subject?.SubjectName</td>
                                <td>@mark.InternalMark</td>
                                <td>@mark.ExternalMark</td>
                                <td class="fw-bold">@mark.Total</td>
                                <td><span class="badge bg-secondary">@mark.Grade</span></td>
                                <td>
                                    @if(mark.ResultStatus == "PASS")
                                    {
                                        <span class="badge bg-success">PASS</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">FAIL</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-warning mb-0">
                <i class="bi bi-exclamation-triangle"></i> No marks recorded for this student yet.
            </div>
        }
    </div>
</div>
