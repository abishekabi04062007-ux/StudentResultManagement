@model StudentResultManagement.Models.Subject
@{
    ViewData["Title"] = "Create Subject";
}
<h1>Create Subject</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-2">
                <label asp-for="SubjectCode" class="control-label"></label>
                <input asp-for="SubjectCode" class="form-control" />
                <span asp-validation-for="SubjectCode" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="SubjectName" class="control-label"></label>
                <input asp-for="SubjectName" class="form-control" />
                <span asp-validation-for="SubjectName" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Department" class="control-label"></label>
                <input asp-for="Department" class="form-control" />
            </div>
            <div class="form-group mb-2">
                <label asp-for="Year" class="control-label"></label>
                <input asp-for="Year" class="form-control" />
            </div>
            <div class="form-group mb-2">
                <label asp-for="Semester" class="control-label"></label>
                <input asp-for="Semester" class="form-control" />
            </div>
            <div class="form-group mb-2">
                <label asp-for="Credits" class="control-label"></label>
                <input asp-for="Credits" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
