@model StudentResultManagement.Models.Subject
@{
    ViewData["Title"] = "Delete Subject";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-trash text-danger"></i> Delete Subject</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-octagon-fill"></i> @TempData["Error"]
    </div>
}

<div class="alert alert-warning">
    <h4><i class="bi bi-exclamation-triangle"></i> Are you sure you want to delete this subject?</h4>
    <p>This action cannot be undone.</p>
</div>

<div class="card card-custom">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Subject Code</dt>
            <dd class="col-sm-9 fw-bold">@Model.SubjectCode</dd>
            
            <dt class="col-sm-3">Subject Name</dt>
            <dd class="col-sm-9">@Model.SubjectName</dd>
            
            <dt class="col-sm-3">Department</dt>
            <dd class="col-sm-9">@Model.Department</dd>
            
            <dt class="col-sm-3">Year / Semester</dt>
            <dd class="col-sm-9">@Model.Year / @Model.Semester</dd>
            
            <dt class="col-sm-3">Credits</dt>
            <dd class="col-sm-9">@Model.Credits</dd>
        </dl>
        
        <form asp-action="Delete">
            <input type="hidden" asp-for="SubjectId" />
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirm Delete</button>
        </form>
    </div>
</div>
